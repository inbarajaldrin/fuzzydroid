    {
      "name": "robodocs",
      "source": "./plugins/robodocs",
      "version": "0.1.0",
      "description": "Live-fetched documentation skills for the robotics stack — HuggingFace LeRobot and the NVIDIA Physical-AI suite (Isaac Sim/Lab/ROS, GR00T, Cosmos, Warp, Omniverse, OpenUSD)",
      "author": {
        "name": "Aldrin Inbaraj"
      },
      "category": "documentation",
      "homepage": "https://github.com/inbarajaldrin/fuzzydroid",
      "tags": ["robotics", "lerobot", "nvidia", "isaac", "isaac-sim", "isaac-lab", "isaac-ros", "openusd", "omniverse", "docs"]
