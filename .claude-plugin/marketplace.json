{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "fuzzydroid",
  "owner": {
    "name": "Aldrin Inbaraj"
  },
  "metadata": {
    "description": "Robotics-developer plugins for Claude Code",
    "version": "0.2.0"
  },
  "plugins": [
    {
      "name": "fusion",
      "source": "./plugins/fusion",
